# ==============================================================================
# STARS INVESTMENT GROUP - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# NODE & SERVEUR
NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://tracker.starsinvestment.com,https://app.starsinvestment.com

# AUTHENTIFICATION JWT (Générer des clés 64 caractères aléatoires via: openssl rand -base64 48)
JWT_SECRET=CHANGE_THIS_TO_A_VERY_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_VERY_SECURE_RANDOM_KEY_MIN_32_CHARS

# POSTGRESQL (Production Database)
DB_HOST=postgres
DB_PORT=5432
DB_USER=sig_prod_user
DB_PASSWORD=CHANGE_THIS_SECURE_DB_PASSWORD
DB_NAME=sig_tracker_prod
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public&sslmode=prefer"

# REDIS CACHE
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_SECURE_REDIS_PASSWORD

# DOMAIN & SSL (Certbot)
DOMAIN_NAME=api.tracker.starsinvestment.com
ADMIN_EMAIL=admin@starsinvestment.com
