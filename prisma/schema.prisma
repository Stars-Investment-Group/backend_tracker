// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleUser {
  USER
  ADMIN
  ANALYSTE
}

enum AssetClass {
  equity
  bond
  crypto
  fx
  commodity

  @@map("asset_class_enum")
}

enum TransactionType {
  buy
  sell
  dividend

  @@map("transaction_type_enum")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  firstName    String?  @map("first_name")
  lastName     String?  @map("last_name")
  company      String?    @db.VarChar(255)
  role RoleUser @default(USER)
  isActive Boolean @default(true)
  preferences  Json?    @default("{}")
  theme        String   @default("dark")
  lastLogin    DateTime?  @map("last_login") @db.Timestamptz(6)
  portfolios Portfolio[]
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt  @db.Timestamptz(6)


}

model Portfolio {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  name        String
  description String?
  currency    String   @default("USD")
  isActive    Boolean  @default(true) 
  transactions Transaction[]
  createdAt DateTime @default(now()) 
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

}

model Instrument {
  id         String  @id @default(uuid()) @db.Uuid
  ticker     String? @db.VarChar(50)
  name       String  @db.VarChar(255)
  assetClass  AssetClass @map("asset_class")
  sector     String? @db.VarChar(100)
  industry   String? @db.VarChar(100)
  exchange   String? @db.VarChar(50)
  country    String? @db.VarChar(3)
  currency   String  @default("USD") @db.VarChar(3)
  isin       String? @db.VarChar(12)
  cusip      String? @db.VarChar(9)
  sedol      String? @db.VarChar(7)
  metadata   Json?   @default("{}")
  transactions Transaction[]


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt 

  @@index([ticker], name: "idx_instruments_ticker")
  @@index([assetClass], name: "idx_instruments_asset_class")
  @@index([country], name: "idx_instruments_country")

}

model Transaction {
  id              String          @id @default(uuid()) @db.Uuid
  portfolioId     String          @map("portfolio_id") @db.Uuid
  instrumentId    String          @map("instrument_id") @db.Uuid
  transactionType TransactionType @map("transaction_type")
  quantity        Decimal         @db.Decimal(20, 8)
  price           Decimal         @db.Decimal(20, 8)
  fees            Decimal         @default(0) @db.Decimal(20, 8)
  transactionDate DateTime        @map("transaction_date") @db.Date
  notes           String?
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  portfolio  Portfolio  @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  instrument Instrument @relation(fields: [instrumentId], references: [id])

  @@index([portfolioId], name: "idx_transactions_portfolio_id")
  @@index([instrumentId], name: "idx_transactions_instrument_id")
  @@index([transactionDate(sort: Desc)], name: "idx_transactions_transaction_date")
  @@map("transactions")
}
