generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String      @id @default(uuid()) @db.Uuid
  email            String      @unique
  passwordHash     String      @map("password_hash")
  firstName        String?     @map("first_name")
  lastName         String?     @map("last_name")
  preferences      Json?       @default("{}")
  theme            String      @default("dark")
  createdAt        DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime    @updatedAt @db.Timestamptz(6)
  company          String?     @db.VarChar(255)
  isActive         Boolean     @default(true)
  lastLogin        DateTime?   @map("last_login") @db.Timestamptz(6)
  role             RoleUser    @default(USER)
  refreshTokenHash String?     @map("refresh_token_hash") @db.VarChar(255)
  portfolios       Portfolio[]
  alerts           Alert[]
  auditLogs        AuditLog[]
  watchlists       Watchlist[]
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.Uuid
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId], map: "idx_audit_logs_user_id")
  @@index([createdAt(sort: Desc)], map: "idx_audit_logs_created_at")
  @@index([entityType, entityId], map: "idx_audit_logs_entity")
  @@map("audit_logs")
}

model Portfolio {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @db.Uuid
  name         String
  description  String?
  currency     String        @default("USD")
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

model EconomicIndicator {
  id         String   @id @default(uuid()) @db.Uuid
  provider   String
  dataset    String
  seriesCode String   @map("series_code")
  seriesName String   @map("series_name")
  country    String?
  period     String
  value      Float
  fetchedAt  DateTime @default(now()) @map("fetched_at")

  @@unique([provider, dataset, seriesCode, period])
  @@map("economic_indicators")
}

model Instrument {
  id                   String                @id @default(uuid()) @db.Uuid
  ticker               String?               @db.VarChar(50)
  name                 String                @db.VarChar(255)
  sector               String?               @db.VarChar(100)
  industry             String?               @db.VarChar(100)
  exchange             String?               @db.VarChar(50)
  country              String?               @db.VarChar(3)
  currency             String                @default("USD") @db.VarChar(3)
  isin                 String?               @db.VarChar(12)
  cusip                String?               @db.VarChar(9)
  sedol                String?               @db.VarChar(7)
  metadata             Json?                 @default("{}")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  assetClass           AssetClass            @map("asset_class")
  alerts               Alert[]
  newsInstruments      NewsInstrument[]
  priceHistories       PriceHistory[]
  transactions         Transaction[]
  watchlistInstruments WatchlistInstrument[]

  @@index([ticker], map: "idx_instruments_ticker")
  @@index([assetClass], map: "idx_instruments_asset_class")
  @@index([country], map: "idx_instruments_country")
}

model Transaction {
  id              String          @id @default(uuid()) @db.Uuid
  portfolioId     String          @map("portfolio_id") @db.Uuid
  instrumentId    String          @map("instrument_id") @db.Uuid
  transactionType TransactionType @map("transaction_type")
  quantity        Decimal         @db.Decimal(20, 8)
  price           Decimal         @db.Decimal(20, 8)
  fees            Decimal         @default(0) @db.Decimal(20, 8)
  transactionDate DateTime        @map("transaction_date") @db.Date
  notes           String?
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  instrument      Instrument      @relation(fields: [instrumentId], references: [id])
  portfolio       Portfolio       @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId], map: "idx_transactions_portfolio_id")
  @@index([instrumentId], map: "idx_transactions_instrument_id")
  @@index([transactionDate(sort: Desc)], map: "idx_transactions_transaction_date")
  @@map("transactions")
}

model PriceHistory {
  id           String     @id @default(uuid()) @db.Uuid
  instrumentId String     @map("instrument_id") @db.Uuid
  timestamp    DateTime   @db.Timestamptz(6)
  open         Decimal?   @db.Decimal(20, 8)
  high         Decimal?   @db.Decimal(20, 8)
  low          Decimal?   @db.Decimal(20, 8)
  close        Decimal    @db.Decimal(20, 8)
  volume       Decimal?   @db.Decimal(20, 2)
  isAdjusted   Boolean    @default(false) @map("is_adjusted")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([instrumentId, timestamp])
  @@index([instrumentId, timestamp(sort: Desc)], map: "idx_price_history_instrument_timestamp")
  @@index([timestamp(sort: Desc)], map: "idx_price_history_timestamp")
  @@map("price_history")
}

model Alert {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  instrumentId String?     @map("instrument_id") @db.Uuid
  condition    Json?       @default("{}")
  isActive     Boolean     @default(true) @map("is_active")
  triggeredAt  DateTime?   @map("triggered_at") @db.Timestamptz(6)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  alertType    AlertType   @map("alert_type")
  instrument   Instrument? @relation(fields: [instrumentId], references: [id])
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([instrumentId])
  @@map("alerts")
}

model Watchlist {
  id          String                @id @default(uuid()) @db.Uuid
  userId      String                @map("user_id") @db.Uuid
  name        String                @db.VarChar(100)
  isActive    Boolean               @default(true) @map("is_active")
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  instruments WatchlistInstrument[]
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("watchlists")
}

model WatchlistInstrument {
  watchlistId  String     @map("watchlist_id") @db.Uuid
  instrumentId String     @map("instrument_id") @db.Uuid
  instrument   Instrument @relation(fields: [instrumentId], references: [id])
  watchlist    Watchlist  @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@id([watchlistId, instrumentId])
  @@index([instrumentId])
  @@map("watchlist_instruments")
}

model NewsArticle {
  id          String           @id @default(uuid()) @db.Uuid
  title       String           @db.VarChar(255)
  content     String
  summary     String?
  sentiment   NewsSentiment?   @default(neutral)
  source      String?          @db.VarChar(100)
  url         String?          @db.VarChar(500)
  assetClass  AssetClass?      @map("asset_class")
  isBreaking  Boolean          @default(false) @map("is_breaking")
  readCount   Int              @default(0) @map("read_count")
  publishedAt DateTime         @default(now()) @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  instruments NewsInstrument[]

  @@index([publishedAt(sort: Desc)], map: "idx_news_articles_published_at")
  @@index([isBreaking], map: "idx_news_articles_is_breaking")
  @@index([readCount(sort: Desc)], map: "idx_news_articles_read_count")
  @@index([assetClass], map: "idx_news_articles_asset_class")
  @@map("news_articles")
}

model NewsInstrument {
  newsId       String      @map("news_id") @db.Uuid
  instrumentId String      @map("instrument_id") @db.Uuid
  instrument   Instrument  @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  newsArticle  NewsArticle @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@id([newsId, instrumentId])
  @@index([instrumentId], map: "idx_news_instruments_instrument_id")
  @@map("news_instruments")
}

model EconomicEvent {
  id        String      @id @default(uuid()) @db.Uuid
  title     String      @db.VarChar(255)
  country   String      @db.VarChar(3)
  eventDate DateTime    @map("event_date") @db.Timestamptz(6)
  impact    EventImpact @default(medium)
  actual    String?     @db.VarChar(50)
  forecast  String?     @db.VarChar(50)
  previous  String?     @db.VarChar(50)
  unit      String?     @db.VarChar(20)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([eventDate], map: "idx_economic_events_event_date")
  @@index([country], map: "idx_economic_events_country")
  @@index([impact], map: "idx_economic_events_impact")
  @@map("economic_events")
}

model Country {
  code           String          @id @db.VarChar(3)
  name           String          @db.VarChar(100)
  region         String?         @db.VarChar(50)
  subregion      String?         @db.VarChar(50)
  incomeLevel    String?         @map("income_level") @db.VarChar(20)
  currency       String?         @db.VarChar(3)
  latitude       Decimal?        @db.Decimal(10, 6)
  longitude      Decimal?        @db.Decimal(10, 6)
  flagUrl        String?         @map("flag_url") @db.VarChar(255)
  isAggregate    Boolean         @default(false) @map("is_aggregate")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  countryRatings CountryRating[]
  dataReleases   DataRelease[]
  events         Event[]
  macroData      MacroData[]
  macroRegimes   MacroRegime[]
  dataQuality DataQuality[]

  @@index([region], map: "idx_countries_region")
  @@index([incomeLevel], map: "idx_countries_income")
  @@map("countries")
}

model MacroIndicator {
  id                   String        @id @default(uuid()) @db.Uuid
  code                 String        @unique @db.VarChar(50)
  name                 String        @db.VarChar(255)
  description          String?
  category             String?       @db.VarChar(50)
  unit                 String?       @db.VarChar(20)
  frequency            String?       @db.VarChar(20)
  source               String?       @db.VarChar(100)
  isSeasonallyAdjusted Boolean       @default(false) @map("is_seasonally_adjusted")
  coverageStart        DateTime?     @map("coverage_start") @db.Date
  coverageEnd          DateTime?     @map("coverage_end") @db.Date
  metadata             Json?         @default("{}")
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  dataReleases         DataRelease[]
  macroData            MacroData[]
  dataQuality               DataQuality[]
  indicatorCorrelationsFrom IndicatorCorrelation[] @relation("IndicatorCorrelationSource")
  indicatorCorrelationsTo   IndicatorCorrelation[] @relation("IndicatorCorrelationRelated")

  @@index([category], map: "idx_indicators_category")
  @@map("macro_indicators")
}

model MacroData {
  id              String         @id @default(uuid()) @db.Uuid
  countryCode     String         @map("country_code") @db.VarChar(3)
  indicatorId     String         @map("indicator_id") @db.Uuid
  vintageDate     DateTime       @map("vintage_date") @db.Date
  period          DateTime       @db.Date
  value           Decimal        @db.Decimal(20, 6)
  isForecast      Boolean        @default(false) @map("is_forecast")
  isEstimate      Boolean        @default(false) @map("is_estimate")
  releaseDate     DateTime?      @map("release_date") @db.Date
  nextReleaseDate DateTime?      @map("next_release_date") @db.Date
  source          String?        @db.VarChar(100)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  country         Country        @relation(fields: [countryCode], references: [code])
  indicator       MacroIndicator @relation(fields: [indicatorId], references: [id])

  @@unique([countryCode, indicatorId, period, vintageDate], name: "uq_macro_data_country_indicator_period_vintage")
  @@index([countryCode, indicatorId], map: "idx_macro_data_country_indicator")
  @@index([period(sort: Desc)], map: "idx_macro_data_period")
  @@index([vintageDate(sort: Desc)], map: "idx_macro_data_vintage")
  @@map("macro_data")
}

model MacroRegime {
  id             String    @id @default(uuid()) @db.Uuid
  countryCode    String    @map("country_code") @db.VarChar(3)
  regime         String    @db.VarChar(50)
  momentum       String?   @db.VarChar(20)
  confidence     Decimal?  @db.Decimal(5, 2)
  riskScore      Decimal?  @map("risk_score") @db.Decimal(5, 2)
  growthScore    Decimal?  @map("growth_score") @db.Decimal(5, 2)
  inflationScore Decimal?  @map("inflation_score") @db.Decimal(5, 2)
  policyStance   String?   @map("policy_stance") @db.VarChar(50)
  period         DateTime  @db.Date
  validFrom      DateTime  @map("valid_from") @db.Date
  validTo        DateTime? @map("valid_to") @db.Date
  metadata       Json?     @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  country        Country   @relation(fields: [countryCode], references: [code])

  @@index([countryCode, validFrom(sort: Desc)], map: "idx_regimes_country")
  @@index([regime], map: "idx_regimes_regime")
  @@map("macro_regimes")
}

model CountryRating {
  id                String   @id @default(uuid()) @db.Uuid
  countryCode       String   @map("country_code") @db.VarChar(3)
  overallScore      Decimal  @map("overall_score") @db.Decimal(5, 2)
  rating            String?  @db.VarChar(10)
  pillarScores      Json     @map("pillar_scores")
  positiveDrivers   Json?    @map("positive_drivers")
  negativeDrivers   Json?    @map("negative_drivers")
  upgradeTriggers   Json?    @map("upgrade_triggers")
  downgradeTriggers Json?    @map("downgrade_triggers")
  reviewDate        DateTime @map("review_date") @db.Date
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  country           Country  @relation(fields: [countryCode], references: [code])

  @@unique([countryCode, reviewDate], name: "uq_country_rating_country_review_date")
  @@index([countryCode, reviewDate(sort: Desc)], map: "idx_ratings_country")
  @@map("country_ratings")
}

model GlobalKpi {
  id            String   @id @default(uuid()) @db.Uuid
  kpiCode       String   @map("kpi_code") @db.VarChar(50)
  kpiName       String   @map("kpi_name") @db.VarChar(100)
  value         Decimal  @db.Decimal(10, 4)
  previousValue Decimal? @map("previous_value") @db.Decimal(10, 4)
  change        Decimal? @db.Decimal(10, 4)
  changeType    String?  @map("change_type") @db.VarChar(20)
  unit          String?  @db.VarChar(20)
  period        DateTime @db.Date
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([kpiCode, period])
  @@map("global_kpis")
}

model HouseView {
  id              String   @id @default(uuid()) @db.Uuid
  title           String?  @db.VarChar(255)
  narrative       String?
  outlook         String?  @db.VarChar(20)
  scores          Json?
  regionBreakdown Json?    @map("region_breakdown")
  period          DateTime @db.Date
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("house_view")
}

model RegionSnapshot {
  id           String   @id @default(uuid()) @db.Uuid
  regionCode   String   @map("region_code") @db.VarChar(20)
  regionName   String   @map("region_name") @db.VarChar(100)
  overallScore Decimal? @map("overall_score") @db.Decimal(5, 2)
  momentum     String?  @db.VarChar(20)
  riskScore    Decimal? @map("risk_score") @db.Decimal(5, 2)
  pillarScores Json?    @map("pillar_scores")
  period       DateTime @db.Date
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([regionCode, period])
  @@map("region_snapshots")
}

model Event {
  id          String    @id @default(uuid()) @db.Uuid
  eventType   String    @map("event_type") @db.VarChar(50)
  title       String    @db.VarChar(255)
  description String?
  countryCode String?   @map("country_code") @db.VarChar(3)
  regionCode  String?   @map("region_code") @db.VarChar(20)
  eventDate   DateTime  @map("event_date") @db.Date
  eventTime   DateTime? @map("event_time") @db.Time(6)
  impact      String?   @db.VarChar(20)
  importance  Int?
  source      String?   @db.VarChar(100)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  country     Country?  @relation(fields: [countryCode], references: [code])

  @@index([eventDate], map: "idx_events_date")
  @@index([regionCode], map: "idx_events_region")
  @@index([impact], map: "idx_events_impact")
  @@map("events")
}

model DataRelease {
  id            String         @id @default(uuid()) @db.Uuid
  indicatorId   String         @map("indicator_id") @db.Uuid
  countryCode   String         @map("country_code") @db.VarChar(3)
  releaseDate   DateTime       @map("release_date") @db.Date
  period        DateTime       @db.Date
  status        String?        @db.VarChar(20)
  actualValue   Decimal?       @map("actual_value") @db.Decimal(20, 6)
  previousValue Decimal?       @map("previous_value") @db.Decimal(20, 6)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  country       Country        @relation(fields: [countryCode], references: [code])
  indicator     MacroIndicator @relation(fields: [indicatorId], references: [id])

  @@index([releaseDate], map: "idx_data_releases_date")
  @@index([indicatorId], map: "idx_data_releases_indicator")
  @@index([countryCode], map: "idx_data_releases_country")
  @@map("data_releases")
}

model DataQuality {
  id String @id @default(uuid()) @db.Uuid

  indicatorId String @map("indicator_id") @db.Uuid
  countryCode String @map("country_code") @db.VarChar(3)

  sourceReliability       String @map("source_reliability") @db.VarChar(20)
  timeliness              String @db.VarChar(20)
  coverage                String @db.VarChar(20)
  revisionVolatility      String @map("revision_volatility") @db.VarChar(20)
  breaksStructuralChanges String @map("breaks_structural_changes") @db.VarChar(20)

  overallScore Decimal @map("overall_score") @db.Decimal(5, 2)

  period DateTime @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  indicator MacroIndicator @relation(fields: [indicatorId], references: [id])
  country   Country        @relation(fields: [countryCode], references: [code])

  @@index([indicatorId], name: "idx_data_quality_indicator")
  @@index([countryCode], name: "idx_data_quality_country")
  @@index([indicatorId, countryCode], name: "idx_data_quality_indicator_country")

  @@map("data_quality")
}

model IndicatorCorrelation {
  id String @id @default(uuid()) @db.Uuid

  indicatorId        String @map("indicator_id") @db.Uuid
  relatedIndicatorId String @map("related_indicator_id") @db.Uuid

  correlation Decimal @db.Decimal(5, 4)
  periodYears Int     @map("period_years")

  createdAt DateTime @default(now()) @map("created_at")

  indicator MacroIndicator @relation("IndicatorCorrelationSource",  fields: [indicatorId], references: [id] )

  relatedIndicator MacroIndicator @relation( "IndicatorCorrelationRelated",fields: [relatedIndicatorId],references: [id])

  @@unique([indicatorId, relatedIndicatorId, periodYears])
  @@index([indicatorId])
  @@index([relatedIndicatorId])

  @@map("indicator_correlations")
}

enum RoleUser {
  USER
  ADMIN
  ANALYSTE
}

enum AssetClass {
  equity
  bond
  crypto
  fx
  commodity

  @@map("asset_class_enum")
}

enum TransactionType {
  buy
  sell
  dividend

  @@map("transaction_type_enum")
}

enum AlertType {
  price
  news
  economic
  earnings

  @@map("alert_type_enum")
}

enum NewsSentiment {
  positive
  neutral
  negative

  @@map("news_sentiment_enum")
}

enum EventImpact {
  low
  medium
  high

  @@map("event_impact_enum")
}
